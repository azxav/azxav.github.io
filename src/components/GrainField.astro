<div class="grain" data-grain data-mode="static">
  <img
    class="grain__fallback"
    data-grain-fallback
    src="/grain-light.webp"
    data-light="/grain-light.webp"
    data-dark="/grain-dark.webp"
    alt=""
    width="1600"
    height="1000"
    decoding="async"
    fetchpriority="low"
  />
  <canvas class="grain__canvas" data-grain-canvas aria-hidden="true"></canvas>
</div>
<script is:inline>
  (function () {
    const img = document.querySelector("[data-grain-fallback]");
    if (!img) return;
    if (document.documentElement.dataset.theme === "dark") {
      const dark = img.getAttribute("data-dark");
      if (dark) img.setAttribute("src", dark);
    }
  })();
</script>
